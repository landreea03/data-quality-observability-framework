# Copy to .env and fill in.
# Local demo without docker/Airflow (uses a SQLite file instead of Postgres):
# DATABASE_URL=sqlite:///data/dq_framework.db

# Full docker-compose stack (Postgres + Airflow):
DATABASE_URL=postgresql+psycopg2://dq_user:dq_pass@localhost:5433/dq_framework

# Slack incoming webhook -- see src/alerts/slack.py header for setup steps.
# Leave blank to run in "dry run" mode (alerts print to stdout instead).
SLACK_WEBHOOK_URL=
